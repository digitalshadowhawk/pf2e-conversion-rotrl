    "details": {
      "isComplex": true,
      "level": {
        "value": 9
      },
      "disable": "<p>Engage the Hill Giants</p>",
      "description": "<p><span style=\"font-family:Vollkorn, Eczar, Georgia, serif;font-size:15.6px\">All eight giants then arrange themselves at the top of the stairs, where large piles of throwing boulders have been stacked. If the PCs attempt to climb the stairs, the giants abandon rock throwing in favor of a controlled landslide—they can kick and push and drop boulders down the stairs at an alarming rate. Any characters climbing the stairs must succeed at a </span><code style=\"box-sizing:border-box;user-select:text;color:var(--secondary);font-family:sans-serif;font-size:0.95em;font-weight:bold\">DC 19 Reflex save</code><span style=\"font-family:Vollkorn, Eczar, Georgia, serif;font-size:15.6px\"> each round or take </span><a class=\"inline-roll roll\" style=\"box-sizing:border-box;user-select:text;cursor:url('ui/cursors/pointer.webp'), pointer;margin-top:var(--p-space,1em);box-shadow:rgba(255, 255, 255, 0.3) 0px 0px 0px 2px inset, rgba(0, 0, 0, 0.5) 0px 0px 0px 1px inset;font-family:var(--sans-serif);font-size:0.9em;border:initial none initial\" title=\"bludgeoning\" data-mode=\"roll\" data-flavor=\"bludgeoning\" data-formula=\"3d6\"> 3d6</a><span style=\"font-family:Vollkorn, Eczar, Georgia, serif;font-size:15.6px\"> damage from the tumbling stones.</span></p>",
      "reset": null,
      "routine": null
    },
