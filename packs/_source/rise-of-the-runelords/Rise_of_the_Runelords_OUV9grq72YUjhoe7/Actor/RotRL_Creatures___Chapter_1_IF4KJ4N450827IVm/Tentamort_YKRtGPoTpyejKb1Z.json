    {
      "_id": "fFf3x20fD0eIXpQV",
      "name": "Implant Eggs",
      "type": "action",
      "img": "systems/pf2e/icons/actions/OneAction.webp",
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {
