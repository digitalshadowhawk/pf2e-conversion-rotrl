          "source": ""
        }
      },
      "system": {
        "description": {
          "gm": "",
          "value": "<p><strong>Requirements</strong> The Tentamort has a creature grabbed with the immobilized condition<strong> Effect</strong> The Tentamort implants eggs under the skin of the grabbed creature, exposing it to Tentamort Disease.</p>\n<p><strong>Tentamort Disease</strong> [disease]</p>\n<p><strong>Saving Throw</strong> Fortitude DC 18</p>\n<p><strong>Stage 1 </strong>drained 1 [1 week];</p>\n<p><strong>Stage 2</strong> drained 2 [1 week];</p>\n<p><strong>Stage 3 </strong>6d6 piercing damage as 3d6 hand size Tentamorts emerge from within the victims body. The disease then ends.</p>\n<p>The drained condition cannot be removed until the disease is cured or runs its course.</p>\n<p>&nbsp;</p>"
        },
        "source": {
          "value": ""
        },
        "rules": [],
        "slug": null,
