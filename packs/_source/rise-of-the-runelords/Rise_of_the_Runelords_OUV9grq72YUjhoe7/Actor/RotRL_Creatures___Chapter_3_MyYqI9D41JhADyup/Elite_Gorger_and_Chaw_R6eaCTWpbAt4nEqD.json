    {
      "_id": "fs49A2QDgfg74MTh",
      "name": "Independent Brains",
      "type": "action",
      "sort": 400000,
      "flags": {
        "pick-up-stix": {
          "pick-up-stix": {
            "owner": "92yAuC9IsLH8608F"
          }
        }
      },
      "img": "systems/pf2e/icons/default-icons/mystery-man.svg",
      "effects": [],
      "folder": null,
      "system": {
        "description": {
          "gm": "",
          "value": "Each of an ettin's heads rolls its own initiative and has its own turn. Neither head can Delay. At the start of a head's turn, that head gets 2 actions and 1 reaction. Each brain controls one of the ettin's arms, but both can move the legs. Any ability that would sever an ettin's head (such as the vorpal weapon property) doesn't cause the ettin to die if it still has its other head, but does cause it to lose the turns, actions, and reactions of the severed head. Mental effects that target a single creature affect only one of the ettin's heads.",
          "chat": "",
          "unidentified": ""
        },
