      "name": "Steal Shadow",
      "sort": 600000,
      "type": "action",
      "folder": null,
      "system": {
        "description": {
          "gm": "",
          "value": "<p><strong>Requirement</strong> The shadow hit a living creature with a shadow hand Strike on its previous action.</p>\n<p><strong>Effect</strong> The shadow pulls at the target's shadow, making the creature @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 1}. This is cumulative with other Enfeebled conditions from shadows, to a maximum of Enfeebled 4.<span data-visibility=\"gm\"> If this increases a creature's Enfeebled value to 3 or more, the target's shadow is separated from its body.</span></p>\n<p data-visibility=\"gm\">Enfeebled from Steal Shadow decreases by 1 every hour.</p>"
        },
