      "stealth": {
        "value": 12,
        "details": "<p>@Check[type:occultism|dc:19|name: To Banish Haunt|traits:complex,haunt] (expert) To Banish Spirit,</p>\n<p>@Check[type:religion|dc:19|name: To Banish Haunt|traits:complex,haunt] (expert) To Banish Spirit,</p>\n<p>@Check[type:perception|dc:22|name:To Notice Dropping Temperature |traits:complex,haunt] (trained)To Notice Dropping Temperature</p>"
      },
      "emitsSound": "encounter",
