      "stealth": {
        "value": 12,
        "details": "<ul>\n<li><span style=\"font-family: var(--font-primary); font-size: var(--font-size-14);\">@Check[type:perception|dc:22|name:uo smell burnt Fur|traits:complex,haunt,hazard] (trained)</span><span style=\"font-family: var(--font-primary); font-size: var(--font-size-14);\">&nbsp;</span>to smell burnt fur</li>\n</ul>"
      },
      "emitsSound": "encounter",
