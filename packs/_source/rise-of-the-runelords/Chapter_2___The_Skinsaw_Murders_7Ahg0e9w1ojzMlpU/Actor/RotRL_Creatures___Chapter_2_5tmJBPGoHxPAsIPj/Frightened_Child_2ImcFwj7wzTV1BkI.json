    "details": {
      "isComplex": true,
      "level": {
        "value": 3
      },
      "disable": "<p>@Check[type:diplomacy|dc:20|name:To Comfort Child|traits:complex,haunt] (expert) To Comfort Child,</p>\n<p>@Check[type:occultism|dc:20|name:To Soothe Spirit|traits:complex,haunt] (expert) To Soothe Spirit,</p>\n<p>@Check[type:religion|dc:19|name: To Soothe Spirit|traits:complex,haunt] (expert) To Soothe Spirit,</p>\n<p>@Check[type:perception|dc:20|name:To Hear Child Sobbing|traits:complex,haunt] (trained) To Hear Child Sobbing.</p>",
      "description": "<p style=\"text-align:justify\">The haunted character sees the ghostly outline of a small child, and suddenly becomes convinced that his parents are trying to kill each other, and that whichever of them survives will be coming to kill him next; he has a vision of his mother, wielding a torch, and his father, festering with tumors and wielding a long knife, both struggling to kill each other.</p>",
      "reset": "<p>The haunt automatically resets after 1 day until the supernatural fungus in B37 is dealt with, even if the haunt was previously disabled.</p>",
