      "system": {
        "description": {
          "value": "<p>(acid) Koruvus spews a 20 foot line of foul-smelling and acidic blood from his mouth that deals <strong>4d6</strong> acid damage (<strong>DC 17 Reflex</strong> save). Koruvus can't use Vomit Bile again for 1d4 rounds.</p>\n<p><strong>Critical Success</strong> The creature takes no damage</p>\n<p><strong>Success</strong> The creature takes half damage and is sickened for one turn as they shke off the remaining bile</p>\n<p><strong>Failure </strong>The creature takes full damage and is sickened for 1 minute</p>\n<p><strong>Critical Failure</strong> The creature takes double damage and is sickened 2 for 10 minutes. The creature can't reduce its sickened condition below 1 until the 10 minutes has elapsed.</p>",
          "gm": ""
        },
