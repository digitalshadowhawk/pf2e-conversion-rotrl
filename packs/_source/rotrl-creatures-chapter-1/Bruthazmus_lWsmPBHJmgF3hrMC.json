    {
      "type": "action",
      "name": "Flurry Edge",
      "system": {
        "actionType": {
          "value": "passive"
        },
        "description": {
          "value": "<p>Bruthazmus has trained to unleash a devastating flurry of attacks upon his prey. Bruthazmus' multiple attack penalty for attacks against his hunted prey is –3 (–2 with an agile attack) on his second attack of the turn instead of –5, and –6 (–4 with an agile attack) on his third or subsequent attack of the turn, instead of –10.</p>",
          "gm": ""
        },
        "publication": {
          "title": "",
          "authors": "",
          "license": "OGL",
          "remaster": false
        },
