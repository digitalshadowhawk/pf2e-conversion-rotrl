      "img": "systems/pf2e/icons/default-icons/mystery-man.svg",
      "effects": [],
      "folder": null,
      "system": {
        "description": {
          "value": "<p>All creatures within 30 feet that can see a skull ripper must make a DC 27 Will save at the start of their turn in order to avoid becoming frightened. If the victim recognizes any of the heads affixed to the skull ripper's body as having once belonged to friends or allies, that victim takes a -2 circumstance penalty on the save.</p>\n<p>A creature that succeeds at the save is immune to the dread visage of that particular skull ripper for 24 hours or until a new skull is added to its stinger if sooner.</p>\n<hr />\n<p><strong>Critical Success</strong> The creature is unaffected.<br /><strong>Success</strong> The creature is frightened 1.<br /><strong>Failure</strong> The creature is frightened 2.<br /><strong>Critical Failure</strong> The creature is frightened 4.</p>",
          "gm": ""
        },
