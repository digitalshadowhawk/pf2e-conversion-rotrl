    {
      "folder": "uHxlgOK7MByeLIda",
      "img": "systems/pf2e/icons/actions/OneAction.webp",
      "name": "Hunt Prey",
      "system": {
        "actionType": {
          "value": "action"
        },
        "actions": {
          "value": 1
        },
        "category": "offensive",
        "description": {
          "value": "<p>Teraktinus designates a single creature as his prey and focuses his attacks against that creature. He must be able to see or hear the prey, or he must be tracking the prey.</p><p>He gains a +2 circumstance bonus to Perception checks when he @UUID[Compendium.pf2e.actionspf2e.Item.BlAOM2X92SI6HMtJ]{Seeks} his prey and a +2 circumstance bonus to Survival checks when he @UUID[Compendium.pf2e.actionspf2e.Item.EA5vuSgJfiHH7plD]{Tracks} his prey. Teraktinus also ignores the penalty for making ranged attacks within his second range increment against his prey.</p><p>Lastly, Teraktinus gains a +2 circumstance bonus to Deception checks, Intimidation checks, and Stealth checks against his prey and to any reecall knowledge about his prey, as well as a +1 circumstance bonus to AC against his prey's attacks.</p><p>Teraktinus can have only one prey designated at a time.</p>",
          "gm": ""
        },
        "publication": {
          "license": "ORC",
          "remaster": true,
          "title": "Pathfinder Player Core",
          "authors": ""
        },
        "rules": [
          {
            "key": "FlatModifier",
            "label": "PF2E.SpecificRule.HuntPrey.SeekHuntedPrey",
            "predicate": [
              "action:seek",
              "target:mark:hunted-prey"
            ],
            "selector": "perception",
            "type": "circumstance",
            "value": 2
          },
          {
            "key": "FlatModifier",
            "label": "PF2E.SpecificRule.HuntPrey.TrackHuntedPrey",
            "predicate": [
              "action:track",
              "target:mark:hunted-prey"
            ],
            "selector": "survival",
            "type": "circumstance",
            "value": 2
          },
