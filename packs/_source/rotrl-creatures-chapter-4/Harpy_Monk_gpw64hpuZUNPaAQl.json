    {
      "type": "action",
      "name": "Deflect Projectile",
      "system": {
        "actionType": {
          "value": "reaction"
        },
        "description": {
          "value": "<p><strong>Trigger</strong> You are the targeet of a physical ranged attack.</p><p><strong>Requirements</strong> You are aware of the attack, are not off-guard against it, and have a hand free.</p><hr /><p>You gain a +4 circumstance bonus to AC against the triggering attack. If the attack misses, you have deflected it. You cannot use this feat to deflect unusually massive ranged projectiles (such as boulders or ballista bolts).</p>",
          "gm": ""
        },
