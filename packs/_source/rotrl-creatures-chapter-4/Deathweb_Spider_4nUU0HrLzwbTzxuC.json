    {
      "_id": "XDJqRc88LNHpEfCw",
      "name": "Web Tether",
      "type": "action",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {
