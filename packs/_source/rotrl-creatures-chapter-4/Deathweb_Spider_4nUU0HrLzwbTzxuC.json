    {
      "_id": "ZkxNpcRv2vg43jpJ",
      "name": "Deathweb Spider Infestation Venom",
      "type": "action",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "effects": [],
      "folder": null,
      "sort": 0,
