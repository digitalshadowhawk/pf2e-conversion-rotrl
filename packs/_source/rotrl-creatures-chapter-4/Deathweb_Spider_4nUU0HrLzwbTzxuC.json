        }
      },
      "system": {
        "description": {
          "value": "<p><strong>Saving Throw</strong> <span data-pf2-check=\"fortitude\" data-pf2-traits=\"poison\" data-pf2-label=\"Deathweb Spider Infestation Venom (poison)\" data-pf2-dc=\"30\" data-pf2-show-dc=\"gm\">Fortitude</span></p>\n<p><em data-visibility=\"gm\"><strong>Deathweb Spider Infestation Venom</strong> (poison); Maximum Duration 6 rounds</em></p>\n<p><em data-visibility=\"gm\"><strong>Stage 1</strong>, [[/r 2d6 # poison]] poison damage and @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 1} (1 round)</em></p>\n<p><em data-visibility=\"gm\"><strong>Stage 2</strong>, [[/r 2d6 # poison]] poison damage and @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 2} (1 round)</em></p>\n<p><em data-visibility=\"gm\"><strong>Stage 3</strong>, [[/r 2d6 # poison]] poison damage and @Compendium[pf2e.conditionitems.xYTAsEpcJE1Ccni3]{Slowed 1} for 1 hour</em></p>"
        },
