      "system": {
        "description": {
          "value": "<p><strong>Trigger </strong>Any creature not peacefully accompanied by Conna the Wise enters the room<br /><strong>Effect </strong>After [[/gmroll 1d4]] rounds, the paintings on the wall animate, showing a gruesome sight. The targets have to make a @Check[type:will|dc:34] save, after which the Flayed Giant rolls initiative.</p><hr /><p><strong>Critical Success</strong> The target is unaffected.<br /><strong>Success</strong> The target is @Compendium[pf2e.conditionitems.6uEgoh53GbXuHpTF]{Paralyzed} for 1 round.<br /><strong>Failure </strong>The target is @Compendium[pf2e.conditionitems.6uEgoh53GbXuHpTF]{Paralyzed}for 2 rounds.<br /><strong>Critical Failure</strong> The target is @Compendium[pf2e.conditionitems.6uEgoh53GbXuHpTF]{Paralyzed} for 4 rounds and @Compendium[pf2e.conditionitems.MIRkyAjyBeXivMa7]{Enfeebled 1} for 8 hours.</p>",
          "gm": ""
        },
