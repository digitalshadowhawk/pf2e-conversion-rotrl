    {
      "type": "action",
      "name": "Breath of Death",
      "system": {
        "actionType": {
          "value": "action"
        },
        "description": {
          "value": "<p>The Black Monk exhales a @Template[type:cone|distance:30] cone of tomb gas that deals @Damage[15d6[void]] damage (@Check[type:reflex|dc:34|basic] save). A creature that is killed by this void damage rises [[/r 1d4 #Rounds until rising as a zombie]]{1d4 rounds} later as a zombie under the control of the Black Monk. It gains the undead trait, retains the abilities it had in life, hit points and a weakness to slashing damage appropriate to its level. The Black Monk can't use Breath of Death again for [[/r 1d4 #Recharge Breath of Death]]{1d4 rounds}.</p>",
          "gm": ""
        },
