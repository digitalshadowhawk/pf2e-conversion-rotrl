    {
      "type": "action",
      "name": "Flurry of Blows",
      "system": {
        "actionType": {
          "value": "action"
        },
        "description": {
          "value": "<p>Make two leg strikes, if both hit the same creature, combine their damage for the purpose of resistances and weaknesses. The creature only needs to save once against Insidious Mummy Rot. Apply the creature's multiple attack penalty to the Strikes normally.</p>",
