      "hardness": 0,
      "stealth": {
        "value": 11,
        "details": "<ul>\n<li>@Check[type:perception|dc:22|name:To Hear a Fearful Child Ask \"What's on your face Mommy?\"|traits:complex,haunt] (trained)To Hear a Fearful Child Ask \"What's on your face Mommy?\"</li>\n</ul>\n<p>&nbsp;</p>\n<p><strong>Festering Haunt</strong>: This Haunt only affects those haunted by Vorel Foxglove and his painful death by a thousand of necromantic diseases. If no creatures in a group are haunted by Vorel Foxglove this haunt may target any creature.</p>"
      },
      "emitsSound": "encounter",
      "immunities": [],
      "weaknesses": [],
      "resistances": []
    },
    "details": {
      "isComplex": true,
      "level": {
        "value": 3
      },
      "disable": "<ul>\n<li>@Check[type:medicine|dc:22|name:To Convince the Spirit That Everything is Okay|traits:complex,haunt] (trained) Twice To Convince the Spirit That Nothing is Wrong</li>\n<li>@Check[type:occultism|dc:18|name: To Banish Spirit|traits:complex,haunt] (expert) To Banish Spirit</li>\n<li>@Check[type:religion|dc:18|name: To Banish Spirit|traits:complex,haunt] (expert) To Banish Spirit</li>\n</ul>",
      "description": "<p style=\"text-align:justify\">Suddenly, you feel as if your face had suddenly erupted into a tangled mess of tumors and boils, lasting just long enough for you to attempt to claw the offending sickness from your skull.</p>\n<p style=\"text-align:justify\"> </p>",
      "reset": "<p>The haunt automatically resets after 1 day until the supernatural fungus in B37 is dealt with, even if the haunt was previously disabled.</p>",
      "routine": "<p style=\"text-align: justify;\"><strong>Phage Infection:</strong>&nbsp;<span class=\"pf2-icon\">R</span>&nbsp;<strong>Trigger</strong>&nbsp;Haunted creature enters the room</p>\n<p style=\"text-align: justify;\"><strong>Routine:</strong> A creature that fails its will save against Phage Infection must, on their turn in initiative, succeed at a @Check[type:will|dc:25|name:Suggestion|traits:mental,incapacitating,linguistic,necromancy,occult] basic will save or take&nbsp;<span style=\"text-align: start;\">[[/r {2d12}]]{2d12 damage}</span>&nbsp;as they attempt to claw away the phantom phage on their face- This routine continues until the creature succeeds at two such will saves in a row, is dragged from the room by a successful maneuver, or falls unconscious.&nbsp; &nbsp;&nbsp;</p>\n<p style=\"text-align: justify;\">&nbsp;</p>",
