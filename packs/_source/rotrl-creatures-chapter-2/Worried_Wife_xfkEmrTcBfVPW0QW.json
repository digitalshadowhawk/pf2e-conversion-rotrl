      "stealth": {
        "value": 12,
        "details": "<ul>\n<li><span style=\"font-family: var(--font-primary); font-size: var(--font-size-14);\">@Check[type:perception|dc:22|name:Notice and Hear the Haunt|traits:complex,haunt,hazard] (trained)</span><span style=\"font-family: var(--font-primary); font-size: var(--font-size-14);\">&nbsp;</span>to Notice and Hear the Haunt.</li>\n</ul>"
